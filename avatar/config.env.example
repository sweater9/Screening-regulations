# Copy to config.env (gitignored) and edit. No secrets here.
PROJECT_ID=your-gcp-project
ZONE=us-central1-a            # pick a zone that has L4 (check quota + availability)
VM_NAME=avatar-gpu
MACHINE_TYPE=g2-standard-4    # L4 x1 is bundled with g2-*
BOOT_DISK_GB=200
# Deep Learning VM image with NVIDIA drivers preinstalled; verify current family name:
#   gcloud compute images list --project deeplearning-platform-release --no-standard-images
IMAGE_PROJECT=deeplearning-platform-release
IMAGE_FAMILY=common-cu124-ubuntu-2204   # verify; docs target Ubuntu 24.04 / CUDA 12.4
# Your public IP in CIDR form, e.g. 203.0.113.7/32. Never 0.0.0.0/0.
MY_IP_CIDR=
# WebRTC ports. TCP 8010 per LiveTalking docs; UDP range is a starting point, tighten after testing.
TCP_PORT=8010
UDP_RANGE=1024-65535
# Secret Manager secret names (values are never stored in the repo)
ANTHROPIC_SECRET=anthropic-api-key
